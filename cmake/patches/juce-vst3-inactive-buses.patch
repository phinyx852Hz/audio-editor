+    // PHI: an inactive bus (a side chain the host left off) gets a silent
+    // buffer rather than null channel pointers, because some plugins and bridges
+    // such as yabridge copy every channel of every bus, active or not.
+    template <typename FloatType>
+    static FloatType* inactiveChannel (int numSamples)
+    {
+        alignas (64) static FloatType silence[8192] {};
+        return numSamples <= (int) std::size (silence) ? silence : nullptr;
+    }
