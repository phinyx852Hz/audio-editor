+// PHI: in PHI the background is the colour of the PHI frame the view sits in,
+// so it looks see-through there. PHI exports phi_plugin_background() as 0xAARRGGBB;
+// any other host has no such function and gets the usual gradient.
+static bool phiBackground(juce::Colour &colour)
+{
+#if JUCE_LINUX
+    using Fn = uint32_t (*)();
+    static const auto fn = reinterpret_cast<Fn>(dlsym(RTLD_DEFAULT, "phi_plugin_background"));
+    if (fn != nullptr)
+    {
+        colour = juce::Colour(fn());
+        return true;
+    }
+#endif
+    return false;
+}
+
+// PHI: following the system, the light or dark theme goes by the PHI background
+// instead, so the text stays readable on it.
+static bool darkModeActive()
+{
+    if (juce::Colour phi; phiBackground(phi))
+        return phi.getPerceivedBrightness() < 0.5f;
+    return juce::Desktop::getInstance().isDarkModeActive();
+}
