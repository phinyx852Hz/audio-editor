# Maintainer: TBD
pkgname=audio-editor-git
pkgver=0.1.0
pkgrel=1
pkgdesc="Keyboard-first audio editor and mastering suite for Linux"
arch=('x86_64')
url="https://github.com/phinyx852Hz/audio-editor"
license=('AGPL-3.0-only')
depends=('alsa-lib' 'freetype2' 'fontconfig' 'libx11' 'libxrandr' 'libxinerama' 'libxcursor')
optdepends=('pipewire-jack: low-latency audio through PipeWire'
            'realtime-privileges: realtime scheduling for audio threads')
makedepends=('git' 'cmake' 'ninja' 'jack2')
provides=('audio-editor')
conflicts=('audio-editor')
source=("git+${url}.git")
sha256sums=('SKIP')

build() {
  cmake -S audio-editor -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
