# Maintainer: phinyx852Hz
pkgname=phinyx-git
pkgver=0.2.0
pkgrel=1
pkgdesc="PHINYX: keyboard-first audio editor and mastering suite for Linux"
arch=('x86_64')
url="https://github.com/phinyx852Hz/audio-editor"
license=('AGPL-3.0-only')
depends=('qt6-base' 'qt6-wayland' 'alsa-lib' 'freetype2' 'fontconfig')
optdepends=('pipewire-jack: JACK output through PipeWire (recommended; jack2 also works)'
            'realtime-privileges: realtime scheduling for audio threads'
            "xorg-xwayland: show plugins' own windows on Wayland"
            'lsp-plugins: a large free set of mastering plugins (LV2/VST3)')
# X11 headers are for JUCE (juceaide and plugin windows); ladspa.h for LADSPA hosting
makedepends=('git' 'cmake' 'ninja' 'ladspa' 'libx11' 'libxrandr'
             'libxinerama' 'libxcursor' 'libxcomposite' 'libxext' 'mesa')
provides=('phinyx')
conflicts=('phinyx')
source=("git+${url}.git")
sha256sums=('SKIP')

build() {
  cmake -S audio-editor -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
