# Maintainer: phinyx852Hz
pkgname=phi-git
pkgver=0.5.0
pkgrel=1
pkgdesc="Φ PHI: keyboard-first audio editor and mastering suite for Linux"
arch=('x86_64')
url="https://github.com/phinyx852Hz/audio-editor"
# Every licence in the package (docs/foundations.md)
license=('AGPL-3.0-only' 'GPL-3.0-only' 'GPL-3.0-or-later' 'GPL-2.0-or-later' 'LGPL-3.0-or-later' 'LGPL-2.1-or-later'
         'BSD-3-Clause' 'BSD-2-Clause' 'MIT' 'ISC' '0BSD' 'Zlib' 'Apache-2.0' 'OFL-1.1' 'CC-BY-4.0' 'LicenseRef-Nyquist')
# ffmpeg encodes and decodes the compressed formats, taglib writes their tags
# libusb drives Push 2 and 3's displays
# libsndfile is for Nyquist and the stock plugins; cairo, libglvnd and the X libraries (xcb-util-wm for OctaSine), fftw (Vaporizer2) and curl (Overtonium) for the stock plugins
depends=('qt6-base' 'qt6-wayland' 'alsa-lib' 'libpipewire' 'freetype2' 'fontconfig'
         'cairo' 'libsndfile' 'libglvnd' 'libx11' 'libxrandr' 'libxcursor' 'libxext' 'libxi'
         'ffmpeg' 'taglib' 'xcb-util-wm' 'fftw' 'curl' 'libusb')
optdepends=('qt6-svg: the Φ logo on the windows'
            'pipewire-jack: JACK output through PipeWire (recommended; jack2 also works)'
            'realtime-privileges: realtime scheduling for audio threads'
            "xorg-xwayland: show plugins' own windows on Wayland"
            'lsp-plugins: a large free set of mastering plugins (LV2/VST3/CLAP)'
            'yabridge: Windows VST3 and CLAP plugins through Wine')
# X11 headers are for JUCE (juceaide and plugin windows); ladspa.h and clap for plugin hosting;
# clang builds the ZL Audio stock plugins; python and wget build Cardinal and rust CA-72 and OctaSine (stock instruments)
makedepends=('git' 'cmake' 'ninja' 'ladspa' 'clap' 'libx11' 'libxrandr'
             'libxinerama' 'libxcursor' 'libxcomposite' 'libxext' 'mesa' 'clang' 'python' 'rust' 'xcb-util-wm' 'wget')
provides=('phi')
conflicts=('phi' 'phinyx-git')
replaces=('phinyx-git')   # the name before PHI
source=("git+${url}.git")
sha256sums=('SKIP')

# The version in CMakeLists.txt, then the commits since the start and the commit, e.g. 0.5.0.r812.gb7a9be7
pkgver() {
  cd audio-editor
  printf "%s.r%s.g%s" "$(sed -n 's/^project(Phi VERSION \([0-9.]*\).*/\1/p' CMakeLists.txt)" \
    "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

build() {
  cmake -S audio-editor -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  # JUCE installs its headers, CMake files and juceaide build helper too; PHI needs none of them
  rm -rf "$pkgdir"/usr/{bin,include,lib/cmake}/JUCE-*
}
